{
  "id": "work-visit",
  "license": "PolyForm-Noncommercial-1.0.0",
  "name": "闲不住",
  "version": "3.1.55",
  "description": "在工作时给助手送互动、礼物和恶作剧。展板显示所有助手今天的实时状态，伙伴也会按自己的时间、心情、精力和事件低频更新状态，并提供公共状态池、按伙伴分别解锁的高级状态收藏和伙伴专属状态衣柜；伙伴自主状态与主动心意都可在设置里独立关闭。光粒系统自动积累，小铺可用光粒兑换礼物。通用设计，自动扫描助手目录，无需手动配置。",
  "minAppVersion": "0.1.0",
  "trust": "full-access",
  "install": {
    "defaultEnabled": true
  },
  "activationEvents": [
    "onStartup"
  ],
  "main": "index.js",
  "capabilities": [
    "session",
    "network.fetch"
  ],
  "network": {
    "allowedHosts": [
      "*"
    ],
    "defaultTimeoutMs": 30000
  },
  "contributes": {
    "page": {
      "title": "闲不住",
      "route": "/page"
    },
    "tools": [
      "./tools/check-visits.js",
      "./tools/update-status.js",
      "./tools/sense-state.js"
    ],
    "routes": [
      "./routes/api.js"
    ]
  }
}
